#!/usr/bin/env python3
import tkinter, subprocess, sys
from tkinter import messagebox, ttk
def clean(window):
    for widget in window.winfo_children():
        widget.destroy()
def login():
    clean(mainwindow)
def continuing():
    clean(mainwindow)
def create():
    clean(mainwindow)
def mainpage():
    clean(mainwindow)
    button_login = tkinter.Button(mainwindow, text="Login", command=login)
    button_login.pack(pady=5)
    button_create = tkinter.Button(mainwindow, text="Create", command=create)
    button_create.pack(pady=5)
    button_continue = tkinter.Button(mainwindow, text="Continue", command=continuing)
    button_continue.pack(pady=5)
global mainwindow
mainwindow = tkinter.Tk()
mainwindow.title("Publish")
mainwindow.geometry("400x200")
mainwindow.resizable(True, True)

label = tkinter.Label(mainwindow, text="Welcome to the NLSS Publisher Tool.")
label.pack(pady=20)
button = tkinter.Button(mainwindow, text="Next page.", command=mainpage)
button.pack(pady=10)
mainwindow.mainloop()